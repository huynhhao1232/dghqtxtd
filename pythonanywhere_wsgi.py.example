# Copy nội dung này vào file WSGI trên PythonAnywhere
# (Web tab → WSGI configuration file), rồi sửa yourusername.
#
# Path project = thư mục chứa manage.py (ví dụ ~/DGVC).

import os
import sys

path = '/home/yourusername/DGVC'
if path not in sys.path:
    sys.path.insert(0, path)

os.environ['DJANGO_SETTINGS_MODULE'] = 'edueval.settings'
os.environ['DJANGO_DEBUG'] = '0'
os.environ['DJANGO_ALLOWED_HOSTS'] = 'yourusername.pythonanywhere.com'
os.environ['DJANGO_CSRF_TRUSTED_ORIGINS'] = 'https://yourusername.pythonanywhere.com'
# Tạo key mới: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
os.environ['DJANGO_SECRET_KEY'] = ' thay-bang-secret-key-moi '

# Optional: Long Van S3 for media uploads (or set these in Web → Environment variables)
# Long Van S3: FREE PythonAnywhere accounts cannot reach custom S3 hosts
# (proxy allowlist → ProxyConnectionError / Tunnel 403). Keep USE_S3=0 on free
# PA so media stays under ~/DGVC/media (Static files mapping /media/).
# Paid PA, or after allowlisting s3-hcm5-r1.longvan.net, set USE_S3=1 below
# (must be before get_wsgi_application so it overrides .env).
os.environ['USE_S3'] = '0'
# os.environ['USE_S3'] = '1'
# os.environ['AWS_ACCESS_KEY_ID'] = '...'
# os.environ['AWS_SECRET_ACCESS_KEY'] = '...'
# os.environ['AWS_STORAGE_BUCKET_NAME'] = 'edueval'
# os.environ['AWS_S3_ENDPOINT_URL'] = 'https://s3-hcm5-r1.longvan.net'
# os.environ['AWS_S3_REGION_NAME'] = 'us-east-1'
# os.environ['AWS_S3_ADDRESSING_STYLE'] = 'path'

from django.core.wsgi import get_wsgi_application

application = get_wsgi_application()
