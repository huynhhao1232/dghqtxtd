# Copy to .env and fill in values. Never commit .env (it is gitignored).
# Sao chép thành .env rồi điền giá trị. Không commit file .env.

# --- Django / PythonAnywhere ---
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
# DJANGO_COOKIE_SECURE=0  # set 0 for HTTP-only (before SSL); omit or 1 for HTTPS
# DJANGO_SECRET_KEY=change-me

# --- Long Van S3-compatible object storage (media uploads only) ---
# Bật lưu FileField/ImageField lên S3. Static vẫn trên server PA.
# Enable S3 for FileField/ImageField media. Static files stay on the web server.
USE_S3=1

# AccessKey / SecretKey from Long Van console (never commit real secrets)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Tạo bucket trên Long Van console trước, hoặc dùng bucket đã có.
# Một số gói Long Van giới hạn số bucket — xem `python manage.py check_s3`.
# Create the bucket first, or set the name of an existing bucket.
AWS_STORAGE_BUCKET_NAME=edueval

AWS_S3_ENDPOINT_URL=https://s3-hcm5-r1.longvan.net
# Region often unused for custom endpoints; keep a placeholder for boto3
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path
